{
  "name": "brevis-analytics-backend",
  "version": "1.0.0",
  "description": "Backend server for Brevis Analytics Dashboard",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "fetch:brevis": "node scripts/fetchBrevisData.js",
    "fetch:pancake": "node scripts/fetchPancakeSwapData.js",
    "mock": "node scripts/generateMockData.js",
    "process": "node scripts/processAnalytics.js",
    "setup": "npm run mock && npm run process"
  },
  "keywords": ["blockchain", "analytics", "brevis", "web3"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "node-cron": "^3.0.3"
  }
}
